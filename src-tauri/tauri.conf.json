{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Computer-Auto",
  "version": "2.4.0",
  "identifier": "com.zahidhossin39.computerauto",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Computer-Auto",
        "width": 1020,
        "height": 740,
        "minWidth": 380,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
